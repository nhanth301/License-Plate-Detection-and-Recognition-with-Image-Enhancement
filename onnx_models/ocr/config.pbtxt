name: "ocr"
backend: "onnxruntime"
max_batch_size: 16

input [
  {
    name: "input_image"
    data_type: TYPE_FP32
    dims: [ 3, 128, 128 ]
  }
]

output [
  {
    name: "predictions"
    data_type: TYPE_FP32
    dims: [ 512, 41 ] 
  }
]

instance_group [ { count: 2, kind: KIND_GPU } ]
dynamic_batching { }
